# ── REQUIRED ──────────────────────────────────────────────────────────────────
MONDAY_API_KEY=your_monday_api_token_here

# ── Added automatically by Vercel when you create a KV store ──────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── OPTIONAL — only needed if auto-detection picks the wrong field/column ──────
# Column IDs are shown on the dashboard under "Board columns"
# Field refs appear in "Typeform fields received" inside each event row

# SEARCH_COLUMN=email
# TIME_COLUMN=hour
# DATE_COLUMN=date

# SEARCH_FIELD_REF=abc123
# TIME_FIELD_REF=def456
# DATE_FIELD_REF=ghi789
# NAME_FIELD_REF=jkl012
